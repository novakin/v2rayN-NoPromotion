+<Window x:Class="v2rayN.Views.QuickSplitRuleWindow"
+    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
+    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
+    Title="Quick Split Rule" Width="660" Height="760" MinWidth="560" MinHeight="560"
+    ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
+    Style="{StaticResource WindowGlobal}" Closing="Window_Closing">
+    <DockPanel Margin="20">
+        <StackPanel DockPanel.Dock="Bottom">
+            <TextBlock x:Name="txtError" TextWrapping="Wrap" Margin="0,8,0,8"
+                       FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite" />
+            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
+                <Button x:Name="btnCancel" Content="Cancel" IsCancel="True" MinWidth="90" Margin="0,0,12,0" />
+                <Button x:Name="btnSave" Content="Add rule" IsDefault="True" MinWidth="110"
+                        IsEnabled="False" Click="Save_Click" />
+            </StackPanel>
+        </StackPanel>
+        <ScrollViewer VerticalScrollBarVisibility="Auto">
+            <StackPanel x:Name="form">
+                <TextBlock Text="Quick Split Rule" FontSize="22" FontWeight="SemiBold" />
+                <TextBlock Text="One target. One routing rule. Existing rules stay in place."
+                           TextWrapping="Wrap" Margin="0,4,0,16" />
+                <TextBlock x:Name="txtProfile" FontWeight="SemiBold" TextWrapping="Wrap" />
+                <TextBlock x:Name="txtProfileWarning" TextWrapping="Wrap" Margin="0,4,0,12" />
+                <Grid>
+                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
+                    <StackPanel Margin="0,0,12,0">
+                        <Label Target="{Binding ElementName=cmbType}" Content="Target type" Padding="0,0,0,4" />
+                        <ComboBox x:Name="cmbType" SelectedIndex="0" SelectionChanged="Input_Changed">
+                            <ComboBoxItem Content="Domain / website" /><ComboBoxItem Content="IP / CIDR" /><ComboBoxItem Content="Windows process" />
+                        </ComboBox>
+                    </StackPanel>
+                    <StackPanel Grid.Column="1">
+                        <Label Target="{Binding ElementName=cmbOutbound}" Content="Route through" Padding="0,0,0,4" />
+                        <ComboBox x:Name="cmbOutbound" SelectedIndex="1" SelectionChanged="Input_Changed">
+                            <ComboBoxItem Content="Direct (bypass proxy)" /><ComboBoxItem Content="Proxy (current server)" />
+                        </ComboBox>
+                    </StackPanel>
+                </Grid>
+                <Label Target="{Binding ElementName=txtTarget}" Content="Target" Padding="0,14,0,4" />
+                <TextBox x:Name="txtTarget" MaxLength="2048" TextChanged="Target_Changed" />
+                <TextBlock x:Name="txtHint" TextWrapping="Wrap" Margin="0,4,0,8" />
+                <CheckBox x:Name="chkSubdomains" Content="Include this domain and its subdomains"
+                          IsChecked="True" Checked="Option_Changed" Unchecked="Option_Changed" Margin="0,0,0,12" />
+                <Label Target="{Binding ElementName=cmbPlacement}" Content="Position in the active profile" Padding="0,0,0,4" />
+                <ComboBox x:Name="cmbPlacement" SelectedIndex="0" SelectionChanged="Input_Changed">
+                    <ComboBoxItem Content="Before the first general catch-all (keep earlier rules)" />
+                    <ComboBoxItem Content="First rule (highest priority / explicit override)" />
+                </ComboBox>
+                <TextBlock Text="Rule preview" FontWeight="SemiBold" Margin="0,14,0,6" />
+                <TextBox x:Name="txtPreview" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
+                         MinHeight="150" MaxHeight="260" VerticalScrollBarVisibility="Auto"
+                         FontFamily="Consolas" FontSize="12" />
+                <CheckBox x:Name="chkReload" Content="Reload core after saving (briefly interrupts connections)"
+                          IsChecked="True" Margin="0,14,0,8" />
+                <TextBlock Text="A local backup of this profile's rules is required before saving. Domain rules need a hostname visible to the core; a website may use other domains too. Direct rules bypass the proxy, not the TUN interface itself."
+                           TextWrapping="Wrap" FontSize="12" />
+            </StackPanel>
+        </ScrollViewer>
+    </DockPanel>
+</Window>
diff --git a/v2rayN/v2rayN/Views/QuickSplitRuleWindow.xaml.cs b/v2rayN/v2rayN/Views/QuickSplitRuleWindow.xaml.cs
new file mode 100644
--- /dev/null
+++ b/v2rayN/v2rayN/Views/QuickSplitRuleWindow.xaml.cs
@@ -0,0 +1,120 @@
+using System.Windows.Controls;
+using v2rayN.QuickSplit;
+
+namespace v2rayN.Views;
+
+public partial class QuickSplitRuleWindow : Window
+{
+    private RoutingItem? _snapshot;
+    private bool _ready;
+    private bool _saving;
+    public bool Saved { get; private set; }
+    public bool ReloadAfterSave { get; private set; }
+    public string BackupPath { get; private set; } = "";
+
+    public QuickSplitRuleWindow()
+    {
+        InitializeComponent();
+        _ready = true;
+        Loaded += (_, _) => txtTarget.Focus();
+    }
+
+    public async Task LoadProfileAsync()
+    {
+        var items = await AppManager.Instance.RoutingItems();
+        var active = items?.Where(item => item.IsActive).ToList();
+        if (active?.Count != 1)
+            throw new InvalidOperationException("Select an active routing profile in the main window first.");
+        _snapshot = active[0];
+        if (!_snapshot.Enabled || _snapshot.Locked)
+            throw new InvalidOperationException("This routing profile is disabled or locked. Create an editable copy in Routing Settings and select it first.");
+        var server = await AppManager.Instance.GetProfileItem(AppManager.Instance.Config.IndexId);
+        if (server is null || server.ConfigType == EConfigType.Custom)
+            throw new InvalidOperationException("Select a normal server configuration first. Custom configuration files are not edited by Quick Split Rule.");
+        txtProfile.Text = "Active routing profile: " + _snapshot.Remarks;
+        txtProfileWarning.Text = string.IsNullOrWhiteSpace(_snapshot.Url) ? ""
+            : "This profile has an update URL. Re-importing its rules may overwrite your local changes.";
+        RefreshPreview();
+    }
+
+    private SplitRulePlan BuildPlan()
+    {
+        if (_snapshot is null) throw new InvalidOperationException("No editable routing profile is selected.");
+        var kind = (SplitTargetKind)cmbType.SelectedIndex;
+        if (kind == SplitTargetKind.Process && !AppManager.Instance.Config.TunModeItem.EnableTun)
+            throw new ArgumentException("Process rules require TUN mode. Enable TUN first, or add a domain/IP rule.");
+        var rule = QuickSplitRuleLogic.CreateRule(txtTarget.Text, kind, chkSubdomains.IsChecked == true,
+            cmbOutbound.SelectedIndex == 0 ? "direct" : "proxy");
+        return QuickSplitRuleLogic.Plan(_snapshot.RuleSet, rule, (SplitPlacement)cmbPlacement.SelectedIndex);
+    }
+
+    private void RefreshPreview()
+    {
+        if (!_ready || _saving || _snapshot is null) return;
+        chkSubdomains.Visibility = cmbType.SelectedIndex == 0 ? Visibility.Visible : Visibility.Collapsed;
+        txtHint.Text = cmbType.SelectedIndex switch
+        {
+            0 => "Example: chatgpt.com. Pasted HTTP(S) URLs use only their host; paths and ports are not matched.",
+            1 => "Example: 192.168.1.0/24, 1.1.1.1, or fd00::/8. CIDR host bits are normalized in the preview.",
+            _ => "Example: Code.exe. Matches that executable name, not every child process. TUN is required."
+        };
+        try
+        {
+            var plan = BuildPlan();
+            txtPreview.Text = plan.Preview;
+            txtError.Text = "";
+            btnSave.IsEnabled = true;
+        }
+        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException)
+        {
+            txtPreview.Text = "";
+            txtError.Text = string.IsNullOrWhiteSpace(txtTarget.Text) ? "" : ex.Message;
+            btnSave.IsEnabled = false;
+        }
+    }
+
+    private async void Save_Click(object sender, RoutedEventArgs e)
+    {
+        if (_saving || _snapshot is null) return;
+        _saving = true;
+        form.IsEnabled = btnSave.IsEnabled = btnCancel.IsEnabled = false;
+        try
+        {
+            var plan = BuildPlan();
+            var config = AppManager.Instance.Config;
+            var items = await AppManager.Instance.RoutingItems();
+            var current = items?.FirstOrDefault(item => item.Id == _snapshot.Id);
+            if (current is null || !current.IsActive || !current.Enabled || current.Locked
+                || current.RuleSet != _snapshot.RuleSet)
+                throw new InvalidOperationException("The routing profile changed while this window was open. Close it and try again; no rule was saved.");
+            var server = await AppManager.Instance.GetProfileItem(config.IndexId);
+            if (server is null || server.ConfigType == EConfigType.Custom)
+                throw new InvalidOperationException("The server configuration changed. Close this window and try again.");
+
+            BackupPath = QuickSplitRuleStore.Save(
+                Utils.GetConfigPath("guiNDB.db"), Utils.GetConfigPath("quick-split-backups"),
+                _snapshot, plan);
+            Saved = true;
+            ReloadAfterSave = chkReload.IsChecked == true;
+            _saving = false;
+            DialogResult = true;
+        }
+        catch (Exception ex)
+        {
+            Logging.SaveLog("QuickSplitRule", ex);
+            txtError.Text = ex.Message;
+        }
+        finally
+        {
+            _saving = false;
+            form.IsEnabled = btnCancel.IsEnabled = true;
+            // Keep save errors visible until the next edit; prevent accidental repeat submissions.
+            btnSave.IsEnabled = false;
+        }
+    }
+
+    private void Window_Closing(object? sender, CancelEventArgs e) { if (_saving) e.Cancel = true; }
+    private void Input_Changed(object sender, SelectionChangedEventArgs e) => RefreshPreview();
+    private void Target_Changed(object sender, TextChangedEventArgs e) => RefreshPreview();
+    private void Option_Changed(object sender, RoutedEventArgs e) => RefreshPreview();
+}
