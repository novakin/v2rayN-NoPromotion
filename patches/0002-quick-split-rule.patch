+namespace v2rayN.Views;
+
+public partial class MainWindow
+{
+    private bool _quickSplitRuleOpen;
+
+    private async void MenuQuickSplitRule_Click(object sender, RoutedEventArgs e)
+    {
+        if (_quickSplitRuleOpen || ViewModel is null) return;
+        _quickSplitRuleOpen = true;
+        QuickSplitRuleWindow? dialog = null;
+        try
+        {
+            dialog = new QuickSplitRuleWindow { Owner = this };
+            await dialog.LoadProfileAsync();
+            if (dialog.ShowDialog() != true) return;
+            await ViewModel.StatusBarViewModel.RefreshRoutingsMenu();
+            if (dialog.ReloadAfterSave) await ViewModel.Reload();
+            NoticeManager.Instance.Enqueue("Quick Split Rule saved. Backup: " + dialog.BackupPath);
+        }
+        catch (Exception ex)
+        {
+            Logging.SaveLog("QuickSplitRule", ex);
+            var prefix = dialog?.Saved == true
+                ? "The rule was saved, but refreshing/reloading failed. Use Reload after checking the log.\n\n"
+                : "Quick Split Rule could not be opened.\n\n";
+            MessageBox.Show(this, prefix + ex.Message, "Quick Split Rule", MessageBoxButton.OK, MessageBoxImage.Warning);
+        }
+        finally { _quickSplitRuleOpen = false; }
+    }
+}
diff --git a/v2rayN/v2rayN/QuickSplit/QuickSplitRuleLogic.cs b/v2rayN/v2rayN/QuickSplit/QuickSplitRuleLogic.cs
new file mode 100644
--- /dev/null
+++ b/v2rayN/v2rayN/QuickSplit/QuickSplitRuleLogic.cs
@@ -0,0 +1,174 @@
+using System;
+using System.Collections.Generic;
+using System.Globalization;
+using System.Linq;
+using System.Net;
+using System.Net.Sockets;
+using System.Text.Json;
+using System.Text.Json.Nodes;
+using System.Text.Json.Serialization;
+using System.Text.RegularExpressions;
+using ServiceLib.Enums;
+using ServiceLib.Models.Entities;
+
+namespace v2rayN.QuickSplit;
+
+public enum SplitTargetKind { Domain, Ip, Process }
+public enum SplitPlacement { BeforeCatchAll, First }
+public sealed record SplitRulePlan(string RuleSet, string Preview, int Position, int Count);
+
+// Uses the native RulesItem schema. Existing rule objects are kept as JSON nodes
+// so that adding one rule cannot discard fields introduced by upstream.
+public static class QuickSplitRuleLogic
+{
+    private static readonly JsonSerializerOptions JsonOptions = new()
+    {
+        PropertyNameCaseInsensitive = true,
+        ReadCommentHandling = JsonCommentHandling.Skip,
+        DefaultIgnoreCondition = JsonIgnoreCondition.WhenWritingNull,
+        WriteIndented = true
+    };
+
+    public static RulesItem CreateRule(string input, SplitTargetKind kind, bool includeSubdomains, string outbound)
+    {
+        if (outbound is not ("direct" or "proxy"))
+            throw new ArgumentException("Choose Direct or Proxy.");
+        var target = (input ?? "").Trim();
+        if (target.Length == 0 || target.Length > 2048 || target.Any(char.IsControl))
+            throw new ArgumentException("Enter one target, without line breaks.");
+
+        var rule = new RulesItem
+        {
+            Id = Guid.NewGuid().ToString("N"),
+            Enabled = true,
+            RuleType = ERuleType.Routing,
+            OutboundTag = outbound
+        };
+        switch (kind)
+        {
+            case SplitTargetKind.Domain:
+                target = NormalizeDomain(target);
+                rule.Domain = [(includeSubdomains ? "domain:" : "full:") + target];
+                break;
+            case SplitTargetKind.Ip:
+                target = NormalizeIp(target);
+                rule.Ip = [target];
+                break;
+            case SplitTargetKind.Process:
+                if (!Regex.IsMatch(target, @"^[^<>:""/\\|?*\x00-\x1F]+\.exe$", RegexOptions.IgnoreCase)
+                    || target.Contains(',') || target.Contains(';'))
+                    throw new ArgumentException("Enter an executable name such as Code.exe, not a path or command line.");
+                rule.Process = [target];
+                break;
+            default:
+                throw new ArgumentException("Choose a target type.");
+        }
+        rule.Remarks = $"Quick Split: {target} -> {outbound}";
+        return rule;
+    }
+
+    public static string NormalizeDomain(string target)
+    {
+        if (target.Contains("://", StringComparison.Ordinal))
+        {
+            if (!Uri.TryCreate(target, UriKind.Absolute, out var uri)
+                || uri.Scheme is not ("http" or "https") || uri.UserInfo.Length != 0)
+                throw new ArgumentException("Use a domain or an HTTP(S) URL without credentials.");
+            target = uri.IdnHost;
+        }
+        if (target.EndsWith('.')) target = target[..^1];
+        if (target.Length == 0 || IPAddress.TryParse(target, out _))
+            throw new ArgumentException("For an IP address, select IP / CIDR instead of Domain.");
+        try { target = new IdnMapping().GetAscii(target).ToLowerInvariant(); }
+        catch (ArgumentException) { throw new ArgumentException("This is not a valid domain name."); }
+        if (target.Length > 253 || target.Split('.').Any(label => label.Length is < 1 or > 63
+                || !Regex.IsMatch(label, @"^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$")))
+            throw new ArgumentException("Use a domain such as chatgpt.com. Wildcards, ports and geosite expressions belong in the full rule editor.");
+        return target;
+    }
+
+    public static string NormalizeIp(string target)
+    {
+        var parts = target.Split('/');
+        if (parts.Length > 2 || target.Any(char.IsWhiteSpace) || target.IndexOfAny(['%', '[', ']']) >= 0
+            || !IPAddress.TryParse(parts[0], out var address))
+            throw new ArgumentException("Use an IPv4/IPv6 address or CIDR, for example 192.168.1.0/24 or fd00::/8.");
+        // IPAddress accepts shorthand and legacy hex/octal IPv4; do not turn a typo into a rule.
+        if (address.AddressFamily == AddressFamily.InterNetwork
+            && !Regex.IsMatch(parts[0], @"^(0|[1-9][0-9]{0,2})(\.(0|[1-9][0-9]{0,2})){3}$"))
+            throw new ArgumentException("IPv4 must contain four decimal octets, without leading zeroes.");
+        if (parts.Length == 1) return address.ToString();
+        var bits = address.AddressFamily == AddressFamily.InterNetwork ? 32 : 128;
+        if (!int.TryParse(parts[1], NumberStyles.None, CultureInfo.InvariantCulture, out var prefix)
+            || prefix < 0 || prefix > bits)
+            throw new ArgumentException($"The CIDR prefix must be between 0 and {bits}.");
+        var bytes = address.GetAddressBytes();
+        for (var i = 0; i < bytes.Length; i++)
+        {
+            var retained = Math.Clamp(prefix - i * 8, 0, 8);
+            bytes[i] &= (byte)(0xff << (8 - retained));
+        }
+        return new IPAddress(bytes) + "/" + prefix.ToString(CultureInfo.InvariantCulture);
+    }
+
+    public static SplitRulePlan Plan(string? original, RulesItem rule, SplitPlacement placement)
+    {
+        JsonArray nodes;
+        try
+        {
+            nodes = JsonNode.Parse(string.IsNullOrWhiteSpace(original) ? "[]" : original,
+                new JsonNodeOptions { PropertyNameCaseInsensitive = true },
+                new JsonDocumentOptions { CommentHandling = JsonCommentHandling.Skip }) as JsonArray
+                ?? throw new ArgumentException("The saved rules are not a JSON array. Use Routing Settings to repair them first.");
+        }
+        catch (JsonException) { throw new ArgumentException("The saved rules contain invalid JSON. Nothing has been changed."); }
+        var existing = new List<RulesItem>();
+        foreach (var node in nodes)
+        {
+            if (node is not JsonObject) throw new ArgumentException("The saved rule list contains an invalid entry.");
+            try { existing.Add(node.Deserialize<RulesItem>(JsonOptions) ?? throw new JsonException()); }
+            catch (JsonException) { throw new ArgumentException("A saved rule has an invalid field. Open Routing Settings before adding a quick rule."); }
+        }
+        var duplicate = existing.FindIndex(item => IsEquivalent(item, rule)
+            && !HasUnknownFields((JsonObject)nodes[existing.IndexOf(item)]!));
+        if (duplicate >= 0)
+            throw new ArgumentException($"An equivalent enabled rule already exists at position {duplicate + 1}. Edit or move it in Routing Settings instead.");
+
+        if (placement is not (SplitPlacement.First or SplitPlacement.BeforeCatchAll))
+            throw new ArgumentException("Choose an insertion position.");
+        var index = placement == SplitPlacement.First ? 0 : nodes.Count;
+        if (placement == SplitPlacement.BeforeCatchAll)
+        {
+            for (var i = 0; i < existing.Count; i++)
+            {
+                if (IsCatchAll(existing[i]) && !HasUnknownFields((JsonObject)nodes[i]!))
+                { index = i; break; }
+            }
+        }
+        var position = index == nodes.Count ? "At the end (no general catch-all found)."
+            : index == 0 ? "First rule (highest priority in this profile)."
+            : $"Before rule {index + 1}: {existing[index].Remarks ?? existing[index].OutboundTag}.";
+        var prior = index > 0 ? $"\n{index} earlier rule(s) remain ahead of this one and may take precedence. Choose First to make this an override." : "";
+        var preview = $"Insert at position {index + 1}. {position}{prior}\n\n" + JsonSerializer.Serialize(rule, JsonOptions);
+        nodes.Insert(index, JsonSerializer.SerializeToNode(rule, JsonOptions));
+        return new SplitRulePlan(nodes.ToJsonString(JsonOptions), preview, index + 1, nodes.Count);
+    }
+
+    private static readonly HashSet<string> KnownFields = new(StringComparer.OrdinalIgnoreCase)
+    { "Id", "Type", "Port", "Network", "InboundTag", "OutboundTag", "Ip", "Domain", "Protocol", "Process", "Enabled", "Remarks", "RuleType" };
+    private static bool HasUnknownFields(JsonObject node) => node.Any(pair => pair.Value != null && !KnownFields.Contains(pair.Key));
+    private static bool Has(ICollection<string>? values) => values?.Count > 0;
+    private static bool Routing(RulesItem rule) => rule.Enabled && (rule.RuleType is null or ERuleType.ALL or ERuleType.Routing);
+    private static bool Unrestricted(RulesItem rule) => string.IsNullOrWhiteSpace(rule.Network)
+        && string.IsNullOrWhiteSpace(rule.Port) && !Has(rule.Protocol) && !Has(rule.InboundTag);
+    private static bool Same(ICollection<string>? a, ICollection<string>? b) =>
+        (a ?? []).OrderBy(x => x, StringComparer.OrdinalIgnoreCase)
+            .SequenceEqual((b ?? []).OrderBy(x => x, StringComparer.OrdinalIgnoreCase), StringComparer.OrdinalIgnoreCase);
+    private static bool IsEquivalent(RulesItem a, RulesItem b) => Routing(a) && Unrestricted(a)
+        && string.Equals(a.OutboundTag, b.OutboundTag, StringComparison.OrdinalIgnoreCase)
+        && Same(a.Domain, b.Domain) && Same(a.Ip, b.Ip) && Same(a.Process, b.Process);
+    private static bool IsCatchAll(RulesItem rule) => Routing(rule) && !string.IsNullOrWhiteSpace(rule.OutboundTag)
+        && !Has(rule.Domain) && !Has(rule.Ip) && !Has(rule.Process) && !Has(rule.Protocol) && !Has(rule.InboundTag)
+        && (string.IsNullOrWhiteSpace(rule.Port) || rule.Port.Trim() is "0-65535" or "1-65535")
+        && (string.IsNullOrWhiteSpace(rule.Network) || Same(rule.Network.Split(',').Select(x => x.Trim()).ToArray(), ["tcp", "udp"]));
+}
diff --git a/v2rayN/v2rayN/QuickSplit/QuickSplitRuleStore.cs b/v2rayN/v2rayN/QuickSplit/QuickSplitRuleStore.cs
new file mode 100644
--- /dev/null
+++ b/v2rayN/v2rayN/QuickSplit/QuickSplitRuleStore.cs
@@ -0,0 +1,37 @@
+using System;
+using System.IO;
+using System.Text;
+using SQLite;
+using ServiceLib.Models.Entities;
+
+namespace v2rayN.QuickSplit;
+
+public static class QuickSplitRuleStore
+{
+    public static string Save(string databasePath, string backupDirectory, RoutingItem snapshot, SplitRulePlan plan)
+    {
+        if (!File.Exists(databasePath)) throw new IOException("The existing v2rayN configuration database was not found.");
+        if (!snapshot.IsActive || !snapshot.Enabled || snapshot.Locked || string.IsNullOrWhiteSpace(snapshot.Id))
+            throw new InvalidOperationException("Select an active, enabled, editable routing profile first.");
+        Directory.CreateDirectory(backupDirectory);
+        var backup = Path.Combine(backupDirectory, $"rules-{DateTime.UtcNow:yyyyMMdd-HHmmssfff}-{Guid.NewGuid():N}.json");
+        using (var stream = new FileStream(backup, FileMode.CreateNew, FileAccess.Write, FileShare.None))
+        using (var writer = new StreamWriter(stream, new UTF8Encoding(false)))
+        {
+            writer.Write(string.IsNullOrWhiteSpace(snapshot.RuleSet) ? "[]" : snapshot.RuleSet);
+            writer.Flush();
+            stream.Flush(true);
+        }
+        // Use the same SQLite library and table as upstream. A parameterized,
+        // conditional update prevents stale dialogs from replacing newer rules.
+        // Only the two rule fields change; other profile settings are untouched.
+        using var db = new SQLiteConnection(databasePath, false);
+        var changed = db.Execute(
+            "UPDATE RoutingItem SET RuleSet = ?, RuleNum = ? " +
+            "WHERE Id = ? AND RuleSet IS ? AND IsActive = 1 AND Enabled = 1 AND Locked = 0",
+            plan.RuleSet, plan.Count, snapshot.Id, snapshot.RuleSet);
+        if (changed != 1)
+            throw new InvalidOperationException("The routing profile changed while this window was open. No rule was saved. Close it and try again. Backup: " + backup);
+        return backup;
+    }
+}
