+<Window x:Class="v2rayN.Views.QuickSplitWindow"
+    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
+    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
+    Title="Quick Split Rule - test build" Width="650" Height="730"
+    MinWidth="560" MinHeight="540" ShowInTaskbar="False"
+    WindowStartupLocation="CenterOwner" Style="{StaticResource WindowGlobal}"
+    Closing="Window_Closing">
+    <DockPanel Margin="24">
+        <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
+            <CheckBox x:Name="chkReload" Content="Reload core after saving (interrupts existing connections)"
+                      IsChecked="True" Margin="0,0,0,14" />
+            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
+                <Button x:Name="btnCancel" Content="Cancel" IsCancel="True" MinWidth="90" Margin="0,0,12,0" />
+                <Button x:Name="btnSave" Content="Add rule" IsDefault="True" MinWidth="110"
+                        IsEnabled="False" Click="Save_Click" />
+            </StackPanel>
+        </StackPanel>
+        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
+            <StackPanel x:Name="inputPanel">
+                <TextBlock Text="Quick Split Rule" FontSize="24" FontWeight="SemiBold" />
+                <TextBlock Text="Add one rule to the active routing profile." Margin="0,4,0,16" />
+                <TextBlock x:Name="txtProfile" TextWrapping="Wrap" FontWeight="SemiBold" />
+                <TextBlock x:Name="txtProfileWarning" TextWrapping="Wrap" Margin="0,4,0,12" />
+                <Label Content="_Target type" Target="{Binding ElementName=cmbType}" Padding="0,8,0,4" />
+                <ComboBox x:Name="cmbType" SelectedIndex="0" Style="{StaticResource DefComboBox}"
+                          SelectionChanged="PreviewChanged" AutomationProperties.Name="Target type">
+                    <ComboBoxItem Content="Domain" />
+                    <ComboBoxItem Content="IP address / CIDR range" />
+                    <ComboBoxItem Content="Process name (TUN)" />
+                </ComboBox>
+                <Label Content="_Target" Target="{Binding ElementName=txtTarget}" Padding="0,12,0,4" />
+                <TextBox x:Name="txtTarget" Style="{StaticResource DefTextBox}" MaxLength="512"
+                         TextChanged="PreviewChanged" AutomationProperties.Name="Target" />
+                <TextBlock x:Name="txtHint" TextWrapping="Wrap" Margin="0,6,0,6" />
+                <CheckBox x:Name="chkSubdomains" Content="Include this domain and all its subdomains"
+                          IsChecked="True" Checked="PreviewChanged" Unchecked="PreviewChanged" Margin="0,2,0,6" />
+                <Label Content="_Route through" Target="{Binding ElementName=cmbOutbound}" Padding="0,8,0,4" />
+                <ComboBox x:Name="cmbOutbound" SelectedIndex="0" Style="{StaticResource DefComboBox}"
+                          SelectionChanged="PreviewChanged" AutomationProperties.Name="Route through">
+                    <ComboBoxItem Content="Direct - bypass the proxy" Tag="direct" />
+                    <ComboBoxItem Content="Proxy - use the configured proxy outbound" Tag="proxy" />
+                </ComboBox>
+                <Label Content="_Position" Target="{Binding ElementName=cmbPosition}" Padding="0,12,0,4" />
+                <ComboBox x:Name="cmbPosition" SelectedIndex="0" Style="{StaticResource DefComboBox}"
+                          SelectionChanged="PreviewChanged" AutomationProperties.Name="Rule position">
+                    <ComboBoxItem Content="Before catch-all (keep earlier rules); otherwise append" />
+                    <ComboBoxItem Content="First rule (override later matching rules)" />
+                </ComboBox>
+                <TextBlock Text="Preview" FontWeight="SemiBold" Margin="0,16,0,6" />
+                <TextBox x:Name="txtPreview" IsReadOnly="True" TextWrapping="Wrap" MinHeight="80"
+                         Style="{StaticResource DefTextBox}" AutomationProperties.Name="Rule preview" />
+                <TextBlock x:Name="txtStatus" TextWrapping="Wrap" Margin="0,8,0,12" />
+                <TextBlock Text="A rules backup is created before saving. Existing rules are preserved. Domain groups (geosite/geoip) and advanced conditions remain in the full Routing settings editor in this first test version."
+                           TextWrapping="Wrap" FontSize="12" />
+            </StackPanel>
+        </ScrollViewer>
+    </DockPanel>
+</Window>
diff --git a/v2rayN/v2rayN/Views/QuickSplitWindow.xaml.cs b/v2rayN/v2rayN/Views/QuickSplitWindow.xaml.cs
new file mode 100644
--- /dev/null
+++ b/v2rayN/v2rayN/Views/QuickSplitWindow.xaml.cs
@@ -0,0 +1,152 @@
+using System.Text.Json;
+using System.Windows.Controls;
+using v2rayN.Features.QuickSplit;
+
+namespace v2rayN.Views;
+
+public partial class QuickSplitWindow : Window
+{
+    private readonly RoutingItem _snapshot;
+    private readonly Func<Task> _reload;
+    private bool _ready;
+    private bool _saving;
+    private bool _saved;
+
+    public QuickSplitWindow(RoutingItem routing, Func<Task> reload)
+    {
+        // The dialog works on a detached snapshot; cancelling cannot edit live data.
+        _snapshot = JsonUtils.DeepCopy(routing) ?? throw new InvalidOperationException("Cannot read this routing profile.");
+        _reload = reload;
+        InitializeComponent();
+        txtProfile.Text = $"Active profile: {_snapshot.Remarks}";
+        txtProfileWarning.Text = string.IsNullOrWhiteSpace(_snapshot.Url) ? string.Empty
+            : "This profile has a source URL. Re-importing its rules may overwrite local additions.";
+        _ready = true;
+        UpdatePreview();
+        Loaded += (_, _) => txtTarget.Focus();
+    }
+
+    private QuickSplitPlan GetPlan()
+    {
+        var type = (QuickSplitTarget)cmbType.SelectedIndex;
+        if (type == QuickSplitTarget.Process && !AppManager.Instance.Config.TunModeItem.EnableTun)
+            throw new ArgumentException("Enable TUN before adding a process rule. Ordinary system-proxy mode cannot reliably identify the originating app.");
+        var outbound = (cmbOutbound.SelectedItem as ComboBoxItem)?.Tag as string ?? string.Empty;
+        return QuickSplitLogic.Prepare(_snapshot.RuleSet, type, txtTarget.Text,
+            chkSubdomains.IsChecked == true, outbound, cmbPosition.SelectedIndex == 1);
+    }
+
+    private void PreviewChanged(object sender, RoutedEventArgs e)
+    {
+        if (_ready) UpdatePreview();
+    }
+
+    private void UpdatePreview()
+    {
+        chkSubdomains.Visibility = cmbType.SelectedIndex == 0 ? Visibility.Visible : Visibility.Collapsed;
+        txtHint.Text = cmbType.SelectedIndex switch
+        {
+            0 => "Example: chatgpt.com. Uncheck below for an exact hostname match.",
+            1 => "Examples: 192.168.1.0/24 or 2001:db8::/32. Network prefixes are normalized in the preview.",
+            _ => "Example: Code.exe. Applies to that executable, not automatically to its child processes. Requires TUN and core process-matching support."
+        };
+        btnSave.IsEnabled = false;
+        try
+        {
+            var plan = GetPlan();
+            var outbound = (cmbOutbound.SelectedItem as ComboBoxItem)?.Tag;
+            txtPreview.Text = $"{plan.Match}  ->  {outbound}\nRule #{plan.Position} of {plan.RuleCount}\n{plan.Description}";
+            txtStatus.Text = plan.Warning;
+            btnSave.IsEnabled = !_saving && !_saved;
+        }
+        catch (Exception ex) when (ex is ArgumentException or JsonException or InvalidOperationException)
+        {
+            txtPreview.Text = string.Empty;
+            txtStatus.Text = ex.Message;
+        }
+    }
+
+    private async void Save_Click(object sender, RoutedEventArgs e)
+    {
+        if (_saving || _saved) return;
+        _saving = true;
+        btnSave.IsEnabled = false;
+        btnCancel.IsEnabled = false;
+        inputPanel.IsEnabled = false;
+        chkReload.IsEnabled = false;
+        var backupPath = string.Empty;
+        try
+        {
+            var plan = GetPlan();
+            // Never overwrite a different active profile or an edited ruleset.
+            var items = await AppManager.Instance.RoutingItems();
+            var current = items?.FirstOrDefault(r => r.Id == _snapshot.Id && r.IsActive);
+            if (current == null || !current.Enabled || current.Locked || current.RuleSet != _snapshot.RuleSet)
+                throw new InvalidOperationException("The active profile or its rules changed. Close this dialog and reopen Quick Split Rule.");
+
+            var outbound = (cmbOutbound.SelectedItem as ComboBoxItem)?.Tag;
+            var confirmation = $"Add to '{current.Remarks}'?\n\n{plan.Match} -> {outbound}\nRule #{plan.Position}: {plan.Description}\n\n{plan.Warning}";
+            if (MessageBox.Show(this, confirmation, "Confirm routing change", MessageBoxButton.OKCancel,
+                MessageBoxImage.Question) != MessageBoxResult.OK) return;
+
+            var backupDir = Path.Combine(Utils.GetBackupPath(""), "quick-split");
+            Directory.CreateDirectory(backupDir);
+            backupPath = Path.Combine(backupDir, $"rules-{DateTime.UtcNow:yyyyMMdd-HHmmssfff}-{Guid.NewGuid():N}.json");
+            // CreateNew + a completed flush before the database write: no backup, no save.
+            using (var stream = new FileStream(backupPath, FileMode.CreateNew, FileAccess.Write, FileShare.None))
+            using (var writer = new StreamWriter(stream, new UTF8Encoding(false)))
+            {
+                writer.Write(string.IsNullOrWhiteSpace(_snapshot.RuleSet) ? "[]" : _snapshot.RuleSet);
+                writer.Flush();
+                stream.Flush(true);
+            }
+
+            // Re-read after confirmation/backup; use fresh metadata rather than the snapshot.
+            items = await AppManager.Instance.RoutingItems();
+            current = items?.FirstOrDefault(r => r.Id == _snapshot.Id && r.IsActive);
+            if (current == null || !current.Enabled || current.Locked || current.RuleSet != _snapshot.RuleSet)
+                throw new InvalidOperationException("The profile changed before saving. No rule was added.");
+            current.RuleSet = plan.RulesJson;
+            current.RuleNum = plan.RuleCount;
+            if (await ConfigHandler.SaveRoutingItem(AppManager.Instance.Config, current) != 0)
+                throw new IOException("The routing profile could not be saved.");
+            _saved = true;
+
+            var status = "Rule saved. Click Reload when you are ready to apply it.";
+            if (chkReload.IsChecked == true)
+            {
+                try
+                {
+                    await _reload();
+                    status = "Rule saved and reload requested. Check the core log for errors; this is not a connectivity test.";
+                }
+                catch (Exception ex)
+                {
+                    status = $"Rule saved, but reload failed: {ex.Message}\nUse Reload after checking the core log.";
+                }
+            }
+            MessageBox.Show(this, $"{status}\n\nRules backup:\n{backupPath}\n\nUndo: remove the new 'Quick Split' rule in Routing settings. To restore all previous rules, import this backup into the same profile and choose replacement rather than append.",
+                "Quick Split Rule", MessageBoxButton.OK, MessageBoxImage.Information);
+        }
+        catch (Exception ex)
+        {
+            MessageBox.Show(this, $"Could not complete the operation: {ex.Message}" +
+                (backupPath.Length == 0 ? string.Empty : $"\n\nBackup path: {backupPath}"),
+                "Quick Split Rule", MessageBoxButton.OK, MessageBoxImage.Error);
+        }
+        finally
+        {
+            _saving = false;
+            btnCancel.IsEnabled = true;
+            inputPanel.IsEnabled = true;
+            chkReload.IsEnabled = true;
+            if (_saved) DialogResult = true;
+            else UpdatePreview();
+        }
+    }
+
+    private void Window_Closing(object? sender, CancelEventArgs e)
+    {
+        if (_saving) e.Cancel = true;
+    }
+}
