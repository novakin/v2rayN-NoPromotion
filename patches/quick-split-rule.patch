diff --git a/v2rayN/v2rayN/Features/QuickSplit/QuickSplitLogic.cs b/v2rayN/v2rayN/Features/QuickSplit/QuickSplitLogic.cs
new file mode 100644
--- /dev/null
+++ b/v2rayN/v2rayN/Features/QuickSplit/QuickSplitLogic.cs
@@ -0,0 +1,161 @@
+// NoPromotion Quick Split Rule: input validation and additive rule planning.
+// No DNS queries, core control, or disk writes are performed by this class.
+using System;
+using System.Collections.Generic;
+using System.Globalization;
+using System.Linq;
+using System.Net;
+using System.Net.Sockets;
+using System.Text.Json;
+using System.Text.Json.Nodes;
+using System.Text.Json.Serialization;
+using System.Text.RegularExpressions;
+using ServiceLib.Enums;
+using ServiceLib.Models.Entities;
+
+namespace v2rayN.Features.QuickSplit;
+
+public enum QuickSplitTarget { Domain, Ip, Process }
+
+public sealed record QuickSplitPlan(string RulesJson, int RuleCount, int Position,
+    string Match, string Description, string Warning);
+
+public static class QuickSplitLogic
+{
+    private static readonly JsonSerializerOptions JsonOptions = new()
+    {
+        PropertyNameCaseInsensitive = true,
+        ReadCommentHandling = JsonCommentHandling.Skip,
+        DefaultIgnoreCondition = JsonIgnoreCondition.WhenWritingNull
+    };
+
+    public static string Normalize(QuickSplitTarget type, string input, bool subdomains)
+    {
+        var value = (input ?? string.Empty).Trim();
+        if (value.Length == 0 || value.Length > 512 || value.Any(char.IsControl))
+            throw new ArgumentException("Enter one target (no line breaks).");
+
+        switch (type)
+        {
+            case QuickSplitTarget.Domain:
+                if (value.Contains(':') || value.IndexOfAny(['/', '\\', '*', '@', '?', '#']) >= 0)
+                    throw new ArgumentException("Enter a hostname only, such as chatgpt.com. URLs, wildcards and geosite groups belong in the full editor.");
+                if (value.EndsWith('.')) value = value[..^1];
+                try { value = new IdnMapping { UseStd3AsciiRules = true }.GetAscii(value).ToLowerInvariant(); }
+                catch (ArgumentException) { throw new ArgumentException("The hostname is not valid."); }
+                if (value.Length > 253 || !value.Contains('.') || IPAddress.TryParse(value, out _) ||
+                    !Regex.IsMatch(value, @"^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+$", RegexOptions.CultureInvariant) ||
+                    value.Split('.').Last().All(char.IsDigit))
+                    throw new ArgumentException("Enter a valid domain with at least two labels, not an IP address.");
+                return (subdomains ? "domain:" : "full:") + value;
+
+            case QuickSplitTarget.Ip:
+                var parts = value.Split('/');
+                if (parts.Length > 2 || parts[0].IndexOfAny(['%', '[', ']']) >= 0 ||
+                    !IPAddress.TryParse(parts[0], out var address))
+                    throw new ArgumentException("Enter an IPv4/IPv6 address or CIDR, such as 192.168.1.0/24.");
+                if (address.AddressFamily == AddressFamily.InterNetwork &&
+                    !Regex.IsMatch(parts[0], @"^(0|[1-9][0-9]{0,2})(\.(0|[1-9][0-9]{0,2})){3}$", RegexOptions.CultureInvariant))
+                    throw new ArgumentException("IPv4 requires four decimal octets, without leading zeroes.");
+                if (address.IsIPv4MappedToIPv6)
+                    throw new ArgumentException("Use the IPv4 address instead of IPv4-mapped IPv6.");
+                if (parts.Length == 1) return address.ToString();
+                var bits = address.AddressFamily == AddressFamily.InterNetwork ? 32 : 128;
+                if (!int.TryParse(parts[1], NumberStyles.None, CultureInfo.InvariantCulture, out var prefix) || prefix < 0 || prefix > bits)
+                    throw new ArgumentException($"CIDR prefix must be between 0 and {bits}.");
+                // Normalize host bits so the preview shows the network actually matched.
+                var bytes = address.GetAddressBytes();
+                for (var i = 0; i < bytes.Length; i++)
+                {
+                    var keep = Math.Clamp(prefix - i * 8, 0, 8);
+                    bytes[i] &= (byte)(0xff << (8 - keep));
+                }
+                return new IPAddress(bytes) + "/" + prefix;
+
+            case QuickSplitTarget.Process:
+                if (!value.EndsWith(".exe", StringComparison.OrdinalIgnoreCase) || value.Length <= 4 ||
+                    value.IndexOfAny(['/', '\\', ':', '*', '?', '"', '<', '>', '|']) >= 0)
+                    throw new ArgumentException("Enter an executable name only, such as Code.exe (not a path or wildcard).");
+                return value;
+
+            default: throw new ArgumentException("Select a supported target type.");
+        }
+    }
+
+    public static QuickSplitPlan Prepare(string originalJson, QuickSplitTarget type, string input,
+        bool subdomains, string outbound, bool firstRule)
+    {
+        if (outbound is not ("direct" or "proxy"))
+            throw new ArgumentException("Choose Direct or Proxy.");
+        var match = Normalize(type, input, subdomains);
+        var array = JsonNode.Parse(string.IsNullOrWhiteSpace(originalJson) ? "[]" : originalJson,
+            documentOptions: new JsonDocumentOptions { CommentHandling = JsonCommentHandling.Skip }) as JsonArray
+            ?? throw new ArgumentException("The current profile does not contain a valid rules array. Use Routing settings to repair it.");
+        var rules = array.Select(node => node?.Deserialize<RulesItem>(JsonOptions)
+            ?? throw new ArgumentException("The current profile contains an empty rule. Use Routing settings to repair it.")).ToList();
+
+        var candidate = new RulesItem
+        {
+            Id = Guid.NewGuid().ToString("N"),
+            Enabled = true,
+            RuleType = ERuleType.Routing,
+            OutboundTag = outbound,
+            Remarks = $"Quick Split: {match} -> {outbound}",
+            Domain = type == QuickSplitTarget.Domain ? [match] : null,
+            Ip = type == QuickSplitTarget.Ip ? [match] : null,
+            Process = type == QuickSplitTarget.Process ? [match] : null
+        };
+
+        // Do not add an exact duplicate. Broader groups/subnets cannot be resolved
+        // reliably here, so their precedence is explained instead of simulated.
+        for (var i = 0; i < rules.Count; i++)
+        {
+            var r = rules[i];
+            if (IsRouting(r) && !HasOtherConditions(r) && HasOnlyKnownFields(array[i]) &&
+                string.Equals(r.OutboundTag, outbound, StringComparison.OrdinalIgnoreCase) &&
+                Same(r.Domain, candidate.Domain) && Same(r.Ip, candidate.Ip) && Same(r.Process, candidate.Process))
+                throw new ArgumentException($"This exact route already exists at rule #{i + 1}. Edit or move it in Routing settings instead.");
+        }
+
+        var catchAll = rules.FindIndex(r => IsCatchAll(r));
+        // Unknown JSON fields may impose conditions in future upstream versions.
+        while (catchAll >= 0 && !HasOnlyKnownFields(array[catchAll]))
+            catchAll = rules.FindIndex(catchAll + 1, r => IsCatchAll(r));
+        var index = firstRule ? 0 : catchAll >= 0 ? catchAll : rules.Count;
+        var description = firstRule ? "First rule: overrides later matching rules."
+            : catchAll >= 0 ? $"Before catch-all rule #{catchAll + 1} ({rules[catchAll].OutboundTag})."
+            : "No unconditional catch-all found: append at the end.";
+        var warning = index == 0 ? string.Empty
+            : "Earlier rules still take priority, including broader domain groups, IP ranges and process rules. This is not a live route test.";
+        if (match.EndsWith("/0", StringComparison.Ordinal))
+            warning += " WARNING: /0 matches every address of this IP family.";
+
+        // Preserve existing rule nodes, including fields this version does not know.
+        array.Insert(index, JsonSerializer.SerializeToNode(candidate, JsonOptions));
+        return new QuickSplitPlan(array.ToJsonString(), array.Count, index + 1, match, description, warning.Trim());
+    }
+
+    public static bool IsCatchAll(RulesItem r)
+    {
+        if (!IsRouting(r) || !string.IsNullOrWhiteSpace(r.Type) && r.Type != "field" ||
+            string.IsNullOrWhiteSpace(r.OutboundTag) ||
+            (r.Domain?.Count ?? 0) != 0 || (r.Ip?.Count ?? 0) != 0 || (r.Process?.Count ?? 0) != 0 ||
+            (r.Protocol?.Count ?? 0) != 0 || (r.InboundTag?.Count ?? 0) != 0)
+            return false;
+        var networks = (r.Network ?? "").Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries);
+        if (networks.Length != 0 && !networks.ToHashSet(StringComparer.OrdinalIgnoreCase).SetEquals(["tcp", "udp"]))
+            return false;
+        // Conservative: only recognize the standard unconditional port forms.
+        return string.IsNullOrWhiteSpace(r.Port) || r.Port.Trim() is "0-65535" or "1-65535";
+    }
+
+    private static bool IsRouting(RulesItem r) => r.Enabled && (r.RuleType is null or ERuleType.ALL or ERuleType.Routing);
+    private static bool HasOtherConditions(RulesItem r) => !string.IsNullOrWhiteSpace(r.Port) ||
+        !string.IsNullOrWhiteSpace(r.Network) || (r.Protocol?.Count ?? 0) != 0 ||
+        (r.InboundTag?.Count ?? 0) != 0 || (!string.IsNullOrWhiteSpace(r.Type) && r.Type != "field");
+    private static bool Same(List<string>? a, List<string>? b) =>
+        (a ?? []).SequenceEqual(b ?? [], StringComparer.OrdinalIgnoreCase);
+    private static bool HasOnlyKnownFields(JsonNode? node) => node is JsonObject obj && obj.All(p =>
+        new[] { "Id", "Type", "Port", "Network", "InboundTag", "OutboundTag", "Ip", "Domain", "Protocol", "Process", "Enabled", "Remarks", "RuleType" }
+        .Contains(p.Key, StringComparer.OrdinalIgnoreCase));
+}
