+namespace v2rayN.Views;
+
+public partial class MainWindow
+{
+    private async void MenuQuickSplit_Click(object sender, RoutedEventArgs e)
+    {
+        menuQuickSplit.IsEnabled = false;
+        try
+        {
+            if (ViewModel == null || !ViewModel.BlReloadEnabled)
+                throw new InvalidOperationException("Wait for v2rayN to finish starting or reloading.");
+            var server = await ConfigHandler.GetDefaultServer(AppManager.Instance.Config);
+            if (server?.ConfigType == EConfigType.Custom)
+                throw new InvalidOperationException("Quick Split Rule does not edit external/custom core configurations. Select a normal server profile first.");
+            var items = await AppManager.Instance.RoutingItems();
+            var active = items?.FirstOrDefault(r => r.IsActive);
+            if (active == null || !active.Enabled || active.Locked)
+                throw new InvalidOperationException("Select an enabled, editable routing profile first.");
+            var window = new QuickSplitWindow(active, async () =>
+            {
+                await ViewModel.StatusBarViewModel.RefreshRoutingsMenu();
+                await ViewModel.Reload();
+            }) { Owner = this };
+            window.ShowDialog();
+        }
+        catch (Exception ex)
+        {
+            MessageBox.Show(this, ex.Message, "Quick Split Rule", MessageBoxButton.OK, MessageBoxImage.Warning);
+        }
+        finally { menuQuickSplit.IsEnabled = true; }
+    }
+}
